{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Note&Pad Lite",
  "mainBinaryName": "Note&Pad Lite",
  "version": "1.1.3",
  "identifier": "net.lonshaus.note-n-pad-lite",
  "build": {
    "beforeBuildCommand": "NOTENPAD_LITE=1 npm run build"
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.lite.plist"
    },
    "fileAssociations": [
      {
        "ext": ["text", "log", "conf", "ini", "cfg", "mbox"],
        "name": "Lonshaus.NoteNPad.PlainText",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Lonshaus.NoteNPad.PlainText",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown", "mkd"],
        "name": "Lonshaus.NoteNPad.Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "Lonshaus.NoteNPad.DelimitedText",
        "description": "Delimited Text Document",
        "role": "Editor"
      }
    ],
    "resources": {
      "resources/privacy/*": null,
      "resources/privacy-lite/*": "privacy-lite/",
      "resources/themes/*": null,
      "resources/themes/ink.json": "themes/ink.json",
      "resources/themes/paper.json": "themes/paper.json"
    },
    "icon": [
      "icons-lite/32x32.png",
      "icons-lite/128x128.png",
      "icons-lite/128x128@2x.png",
      "icons-lite/icon.icns",
      "icons-lite/icon.ico"
    ]
  }
}
