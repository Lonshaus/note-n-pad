<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri v2 merges this file into the generated Info.plist at bundle time
  (https://v2.tauri.app/distribute/macos-application-bundle/). We only add
  localization keys here; app name / version / identifier stay Tauri-generated.

  These keys declare which languages the app bundle supports. macOS decides the
  language of the system-injected Edit-menu items (Writing Tools, AutoFill,
  Start Dictation, Emoji & Symbols) by intersecting the user's preferred system
  languages with this list — it is NOT tied to our in-app language setting and
  cannot be switched at runtime. That is platform behavior, not a bug.
-->
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
      <string>en</string>
      <string>zh-Hant</string>
      <string>zh-Hans</string>
      <string>ja</string>
      <string>ru</string>
      <string>es</string>
      <string>pt-BR</string>
      <string>de</string>
      <string>fr</string>
      <string>ko</string>
      <string>pl</string>
      <string>tr</string>
      <string>it</string>
      <string>th</string>
      <string>vi</string>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array></array>
    <!-- No encryption of our own: the macOS build links no HTTP client and no
         crypto implementation (cargo tree finds neither reqwest nor rustls for
         aarch64-apple-darwin). Declaring it here answers the export-compliance
         question once, instead of on every build upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
  </dict>
</plist>