<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri v2 merges this file into the generated Info.plist at bundle time
  (https://v2.tauri.app/distribute/macos-application-bundle/). We only add
  localization keys here; app name / version / identifier stay Tauri-generated.

  These keys declare which languages the app bundle supports. macOS decides the
  language of the system-injected Edit-menu items (Writing Tools, AutoFill,
  Start Dictation, Emoji & Symbols) by intersecting the user's preferred system
  languages with this list — it is NOT tied to our in-app language setting and
  cannot be switched at runtime. That is platform behavior, not a bug.
-->
