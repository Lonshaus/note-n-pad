{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Note&Pad",
  "mainBinaryName": "Note&Pad",
  "version": "1.0.0",
  "identifier": "net.lonshaus.note-n-pad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "img-src": "'self' docimg: http://docimg.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/uninstall-cleanup.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["text", "log", "conf", "ini", "cfg", "mbox"],
        "name": "Lonshaus.NoteNPad.PlainText",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Lonshaus.NoteNPad.PlainText",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown", "mkd"],
        "name": "Lonshaus.NoteNPad.Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "Lonshaus.NoteNPad.DelimitedText",
        "description": "Delimited Text Document",
        "role": "Editor"
      },
      {
        "ext": [
          "asn",
          "asn1",
          "dtd",
          "edn",
          "in",
          "jsonld",
          "map",
          "nq",
          "nt",
          "properties",
          "rq",
          "sparql",
          "toml",
          "ttl",
          "webidl",
          "xsd",
          "xsl",
          "yaml",
          "yml"
        ],
        "name": "Lonshaus.NoteNPad.StructuredText",
        "description": "Structured Text Document",
        "role": "Editor"
      },
      {
        "ext": ["json", "svg", "xml"],
        "name": "Lonshaus.NoteNPad.StructuredText",
        "description": "Structured Text Document",
        "role": "Editor"
      },
