      }
    ],
    "category": "Productivity",
    "publisher": "Lonshaus",
    "copyright": "Copyright © 2026 Lonshaus",
    "shortDescription": "Sticky notes and a plain-text editor",
    "longDescription": "Quick sticky notes on your desktop, and a plain-text editor that handles very large files.",
    "resources": {
      "resources/themes/*": "themes/",
      "resources/locales/*": "locales/",
      "resources/privacy/*": "privacy/",
      "resources/licenses.json": "licenses.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
