; Restore the previous owner if there was one, otherwise take the key away.
;
; The empty default value has to go before DeleteRegKey /ifempty will do
; anything: Tauri's uninstaller blanks the default rather than removing it, so
; the key still holds one value and /ifempty refuses. Measured on Windows 11 —
; without the extra DeleteRegValue, 206 of 214 keys survived the uninstall.
;
; The OpenWithProgids subkey goes for the same reason: a leftover subkey blocks
; /ifempty exactly as a leftover value does.
;
; A key another application owns keeps a non-empty default or subkeys of its
; own, so it never reaches the delete.
!macro NoteNPadCleanExt EXT PROGID
  ReadRegStr $0 HKCU "Software\Classes\.${EXT}" "${PROGID}_backup"
  ReadRegStr $1 HKCU "Software\Classes\.${EXT}" ""
  DeleteRegValue HKCU "Software\Classes\.${EXT}" "${PROGID}_backup"
  DeleteRegValue HKCU "Software\Classes\.${EXT}\OpenWithProgids" "${PROGID}"
  DeleteRegKey /ifempty HKCU "Software\Classes\.${EXT}\OpenWithProgids"
  ${If} $1 == ""
    ${If} $0 != ""
      WriteRegStr HKCU "Software\Classes\.${EXT}" "" "$0"
    ${Else}
      DeleteRegValue HKCU "Software\Classes\.${EXT}" ""
      DeleteRegKey /ifempty HKCU "Software\Classes\.${EXT}"
    ${EndIf}
  ${EndIf}
!macroend
; The Capabilities subtree goes whole, since every value in it was written
; here. Its parent is only removed when empty, so anything else that ever lands
; under the app's own key survives.
!macro NSIS_HOOK_POSTUNINSTALL
  Push $0
  Push $1
  !insertmacro NoteNPadCleanExt "text" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "log" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "conf" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "ini" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "cfg" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "mbox" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "txt" "Lonshaus.NoteNPad.PlainText"
  !insertmacro NoteNPadCleanExt "md" "Lonshaus.NoteNPad.Markdown"
  !insertmacro NoteNPadCleanExt "markdown" "Lonshaus.NoteNPad.Markdown"
  !insertmacro NoteNPadCleanExt "mkd" "Lonshaus.NoteNPad.Markdown"
  !insertmacro NoteNPadCleanExt "csv" "Lonshaus.NoteNPad.DelimitedText"
  !insertmacro NoteNPadCleanExt "tsv" "Lonshaus.NoteNPad.DelimitedText"
  !insertmacro NoteNPadCleanExt "asn" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "asn1" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "dtd" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "edn" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "in" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "jsonld" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "map" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "nq" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "nt" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "properties" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "rq" "Lonshaus.NoteNPad.StructuredText"
  !insertmacro NoteNPadCleanExt "sparql" "Lonshaus.NoteNPad.StructuredText"
